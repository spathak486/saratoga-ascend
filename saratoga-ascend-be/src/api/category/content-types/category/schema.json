    "caseStudies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-study.case-study",
      "mappedBy": "category"
    },
    "news": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news.news",
      "mappedBy": "category"
    },
    "link": {
      "type": "component",
      "repeatable": false,
      "component": "shared.general-link"
    }
  }
