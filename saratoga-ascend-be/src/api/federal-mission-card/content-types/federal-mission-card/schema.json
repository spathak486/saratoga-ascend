{
  "kind": "collectionType",
  "collectionName": "federal_mission_cards",
  "info": {
    "singularName": "federal-mission-card",
    "pluralName": "federal-mission-cards",
    "displayName": "Federal Mission Card",
    "description": "Federal and Defense mission card with tags, media, video/GIF background, CTA, and CKEditor title"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "subheading": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text",
      "required": false
    },
    "subdescription": {
      "type": "text",
      "required": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "bgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "workforce.support-area-item"
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.general-link"
    }
  }
}
