{
  "kind": "collectionType",
  "collectionName": "specialities",
  "info": {
    "singularName": "speciality",
    "pluralName": "specialities",
    "displayName": "Speciality",
    "description": "Job Specialities (e.g., Healthcare Jobs, IT Jobs, Allied Health, Laboratory & Scientific)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "roleTitle": {
      "type": "string",
      "default": "Medical Pharmacist"
    },
    "description": {
      "type": "text",
      "default": "Connecting cleared, credentialed healthcare professionals with government, military, and local facilities nationwide."
    },
    "doctorImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "ctaLabel": {
      "type": "string",
      "default": "Explore Jobs"
    },
    "ctaHref": {
      "type": "string",
      "default": "/careers/search-jobs"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job.job",
      "mappedBy": "speciality"
    }
  }
}
