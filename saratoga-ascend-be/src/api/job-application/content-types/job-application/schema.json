{
  "kind": "collectionType",
  "collectionName": "job_applications",
  "info": {
    "singularName": "job-application",
    "pluralName": "job-applications",
    "displayName": "Job Application",
    "description": "Job application submissions captured from candidates including resume file"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "jobTitle": {
      "type": "string"
    },
    "jobSlug": {
      "type": "string"
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "careerArea": {
      "type": "string",
      "required": true
    },
    "preferredLocation": {
      "type": "string",
      "required": true
    },
    "employmentPreference": {
      "type": "string",
      "required": true
    },
    "resume": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "status": {
      "type": "enumeration",
      "enum": ["New", "Under Review", "Shortlisted", "Interviewed", "Hired", "Rejected"],
      "default": "New"
    }
  }
}

