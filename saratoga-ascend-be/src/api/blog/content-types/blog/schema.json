{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "regex": "^[A-Za-z0-9-_.~/]*$",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "summary": {
      "type": "text"
    },
    "articleDate": {
      "type": "date"
    },
    "readTime": {
      "type": "integer",
      "default": 5
    },
    "categoryType": {
      "type": "enumeration",
      "enum": [
        "Blog",
        "Newspaper"
      ],
      "default": "Blog"
    },
    "author": {
      "type": "string",
      "default": "Jane Cooper"
    },
    "topic": {
      "type": "enumeration",
      "enum": [
        "Military Medicine",
        "Federal Staffing",
        "Joint Commission Standards",
        "Veterans Affairs",
        "Regulatory Compliance"
      ],
      "default": "Military Medicine"
    },
    "description": {
      "type": "richtext"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "Section": {
      "type": "dynamiczone",
      "components": [
        "references.banner-reference",
        "references.cta",
        "references.fa-qs",
        "references.client-logos-reference",
        "references.service-reference",
        "references.what-we-do-reference",
        "references.mission-reference",
        "references.achievements",
        "references.legal-content",
        "references.happy-clients-reference"
      ]
    }
  }
}
