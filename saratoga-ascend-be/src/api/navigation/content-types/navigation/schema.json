{
  "kind": "singleType",
  "collectionName": "navigations",
  "info": {
    "singularName": "navigation",
    "pluralName": "navigations",
    "displayName": "Navigation",
    "description": "Global header navigation content type"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logoAlt": {
      "type": "string",
      "default": "Saratoga Ascend"
    },
    "homeHref": {
      "type": "string",
      "default": "/"
    },
    "utilityLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-item"
    },
    "primaryLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-item"
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.general-link"
    },
    "searchLabel": {
      "type": "string",
      "default": "Search"
    }
  }
}
