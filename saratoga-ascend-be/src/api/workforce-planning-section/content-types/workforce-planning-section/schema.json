{
  "kind": "collectionType",
  "collectionName": "workforce_planning_sections",
  "info": {
    "singularName": "workforce-planning-section",
    "pluralName": "workforce-planning-sections",
    "displayName": "Workforce Planning Section",
    "description": "From Workforce Planning to Ongoing Support interactive orbital and step process section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "referenceTitle": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": true,
      "default": "From Workforce Planning to Ongoing Support"
    },
    "highlightTitle": {
      "type": "string",
      "default": "From Workforce Planning"
    },
    "centerImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "orbital",
        "accordion"
      ],
      "default": "orbital"
    },
    "cards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::card.card"
    }
  }
}
