{
  "kind": "collectionType",
  "collectionName": "supporting_mission_sections",
  "info": {
    "singularName": "supporting-mission-section",
    "pluralName": "supporting-mission-sections",
    "displayName": "Supporting Mission Section",
    "description": "Supporting the missions that move communities forward section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "referenceTitle": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": true,
      "default": "Supporting the missions that move communities forward."
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "cta": {
      "type": "component",
      "component": "shared.general-link",
      "repeatable": false
    }
  }
}
