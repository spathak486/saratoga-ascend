{
  "kind": "singleType",
  "collectionName": "not_found_pages",
  "info": {
    "singularName": "not-found",
    "pluralName": "not-founds",
    "displayName": "404 Page",
    "description": "Editorial content for the 404 / page-not-found experience"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
