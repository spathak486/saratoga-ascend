      "default": "Oops! Page not found"
    },
    "description": {
      "type": "text",
      "default": "The page you're looking for has moved, been removed, or never existed. Let's get you back on mission."
    },
    "primaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.general-link"
    },
    "secondaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.general-link"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}