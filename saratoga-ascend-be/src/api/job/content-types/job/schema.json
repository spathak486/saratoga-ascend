{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job",
    "description": "Job listings with location, speciality, job-type, rich details, and dynamic labels"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "tagline": {
      "type": "string"
    },
    "salaryRange": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "overviewTitle": {
      "type": "string",
      "default": "Job Overview"
    },
    "overview": {
      "type": "text"
    },
    "responsibilitiesTitle": {
      "type": "string",
      "default": "Responsibilities"
    },
    "responsibilities": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "requirementsTitle": {
      "type": "string",
      "default": "Requirements"
    },
    "requirements": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "benefitsTitle": {
      "type": "string",
      "default": "Benefits"
    },
    "benefits": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "additionalDetailsTitle": {
      "type": "string",
      "default": "Additional Information"
    },
    "additionalDetails": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "applyButton": {
      "type": "component",
      "repeatable": false,
      "component": "shared.general-link"
    },
    "locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::location.location",
      "inversedBy": "jobs"
    },
    "speciality": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::speciality.speciality",
      "inversedBy": "jobs"
    },
    "jobType": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::job-type.job-type",
      "inversedBy": "jobs"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "postedDate": {
      "type": "date"
    }
  }
}
