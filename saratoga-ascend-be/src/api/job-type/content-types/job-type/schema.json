{
  "kind": "collectionType",
  "collectionName": "job_types",
  "info": {
    "singularName": "job-type",
    "pluralName": "job-types",
    "displayName": "Job Type",
    "description": "Employment/Job Types (e.g., Full-Time, Part-Time, Contract, Per Diem, Surge)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job.job",
      "mappedBy": "jobType"
    }
  }
}
