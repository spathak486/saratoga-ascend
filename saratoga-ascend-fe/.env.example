# ==============================================================================
# Saratoga Ascend - Frontend Environment Variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Backend Strapi URL (without trailing slash)
# Points to the Strapi v5 instance (REST & GraphQL: http://localhost:1337/graphql)
STRAPI_API_URL=http://localhost:1337

# Strapi API Token (Server-only)
# Generate from Strapi Admin Panel: Settings -> API Tokens -> Create new API Token (Read-Only or Full Access)
STRAPI_API_TOKEN=

# Mock Mode (Server-only)
# Set to 'true' to use built-in mock data instead of fetching from Strapi.
# Useful during local UI development or when backend content is not yet populated.
USE_MOCKS=false

# ISR Revalidation Secret (Server-only)
# Secret key used to authorize Next.js on-demand cache revalidation requests.
REVALIDATION_SECRET=

# Google reCAPTCHA Site Key (Client-side)
# Required for client-side form verification (job application, contact form).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
